OPENAI_API_KEY=YOUR_OPENAI_API_KEY
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
ANTHROPIC_MODEL=claude-sonnet-5-5

# 사용 방법:
# 1. 이 파일을 .env로 복사: cp multi-llm-rrf/backend/.env.example multi-llm-rrf/backend/.env
# 2. .env 파일을 열어서 실제 API 키로 교체하세요
# 3. OpenAI API 키: https://platform.openai.com/api-keys
# 4. Anthropic API 키: https://console.anthropic.com/settings/keys
